<!DOCTYPE html>
<html lang="en">
<head>
    <script src="/causal_replay_bundle.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cyberforge - Executive Attack Path & Neo4j-Style Interactive Graph</title>
    <style>
        :root {
            --bg-dark: #0a0e17;
            --panel-bg: #111827;
            --panel-border: #1f293d;
            --accent-cyan: #06b6d4;
            --accent-red: #ef4444;
            --accent-amber: #f59e0b;
            --accent-purple: #8b5cf6;
            --accent-emerald: #10b981;
            --text-main: #f3f4f6;
            --text-muted: #94a3b8;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
            background-color: var(--bg-dark);
            color: var(--text-main);
            line-height: 1.5;
            padding: 30px;
        }

        .header {
            border-bottom: 2px solid var(--panel-border);
            padding-bottom: 20px;
            margin-bottom: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand-title {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--accent-cyan);
            letter-spacing: -0.5px;
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 16px;
            margin-bottom: 30px;
        }

        .kpi-card {
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            border-radius: 8px;
            padding: 16px;
            text-align: center;
        }

        .kpi-val {
            font-size: 1.7rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 4px;
        }

        .kpi-lbl {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .incident-dossier {
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            border-radius: 10px;
            padding: 24px;
            margin-bottom: 35px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
        }

        .dossier-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--panel-border);
            padding-bottom: 14px;
            margin-bottom: 20px;
        }

        .dossier-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .badge {
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .badge-CRITICAL { background: rgba(239, 68, 68, 0.2); color: var(--accent-red); border: 1px solid var(--accent-red); }
        .badge-HIGH { background: rgba(245, 158, 11, 0.2); color: var(--accent-amber); border: 1px solid var(--accent-amber); }

        .meta-strip {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            background: #0d131f;
            border: 1px solid var(--panel-border);
            border-radius: 6px;
            padding: 12px 16px;
            margin-bottom: 20px;
            font-size: 0.85rem;
        }

        .section-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--accent-cyan);
            margin: 24px 0 12px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Timeline Table */
        .timeline-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
            margin-bottom: 25px;
        }

        .timeline-table th {
            background: #162032;
            color: var(--text-muted);
            text-align: left;
            padding: 10px 12px;
            border-bottom: 1px solid var(--panel-border);
        }

        .timeline-table td {
            padding: 10px 12px;
            border-bottom: 1px solid #1c2638;
            color: #cbd5e1;
        }

        .timeline-table tr:hover { background: #151e2e; }

        /* NEO4J-STYLE GRAPH WORKSPACE */
        .neo4j-graph-wrapper {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 16px;
            background: #080d16;
            border: 1px solid #1f293d;
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 25px;
            position: relative;
        }

        .canvas-container {
            position: relative;
            height: 550px;
            background: radial-gradient(circle at center, #0f172a 0%, #080d16 100%);
            border: 1px solid #1e293b;
            border-radius: 6px;
            overflow: hidden;
            cursor: default;
        }

        .canvas-container:active {
            cursor: default;
        }

        canvas {
            width: 100%;
            height: 100%;
            display: block;
        }

        .graph-controls {
            position: absolute;
            bottom: 96px;
            left: 12px;
            display: flex;
            gap: 8px;
            z-index: 10;
        }

        .btn-graph {
            background: rgba(30, 41, 59, 0.85);
            border: 1px solid #334155;
            color: #f1f5f9;
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 0.75rem;
            cursor: pointer;
            backdrop-filter: blur(4px);
            font-weight: 600;
            transition: all 0.2s;
        }

        .btn-graph:hover {
            background: #2563eb;
            border-color: #3b82f6;
        }

        .graph-legend {
            position: absolute;
            top: 12px;
            left: 12px;
            display: flex;
            gap: 12px;
            background: rgba(15, 23, 42, 0.85);
            border: 1px solid #1e293b;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            backdrop-filter: blur(4px);
            z-index: 10;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        /* Node Inspector Panel */
        .node-inspector {
            background: #0f172a;
            border: 1px solid #1e293b;
            border-radius: 6px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            max-height: 550px;
        }

        .inspector-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--accent-cyan);
            border-bottom: 1px solid #1e293b;
            padding-bottom: 8px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .inspector-card {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 6px;
            padding: 10px;
            margin-bottom: 10px;
            font-size: 0.8rem;
        }

        /* Blast Radius Lookahead */
        .lookahead-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 20px;
        }

        .lookahead-card {
            background: #141c2b;
            border: 1px solid var(--panel-border);
            border-radius: 8px;
            padding: 16px;
        }

        .lookahead-card.critical {
            border-color: rgba(239, 68, 68, 0.4);
            background: rgba(239, 68, 68, 0.05);
        }

        .asset-row {
            background: #1a2436;
            border: 1px solid #283750;
            border-radius: 6px;
            padding: 10px;
            margin-top: 8px;
            font-size: 0.85rem;
        }

        .remediation-box {
            background: rgba(16, 185, 129, 0.05);
            border: 1px solid rgba(16, 185, 129, 0.3);
            border-radius: 6px;
            padding: 14px 18px;
            font-size: 0.85rem;
            color: #a7f3d0;
        }

        /* TEMPORAL ATTACK ENGINE & SCRUBBER STYLES */
        .temporal-strip {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            background: #090e17;
            border: 1px solid #1e293b;
            border-radius: 6px;
            padding: 12px 16px;
            margin-bottom: 16px;
        }

        .temporal-card {
            background: #0f172a;
            border: 1px solid #1f293d;
            border-radius: 6px;
            padding: 10px 12px;
        }

        .temporal-val {
            font-size: 1.15rem;
            font-weight: 800;
            color: #38bdf8;
            margin-top: 2px;
        }

        .temporal-lbl {
            font-size: 0.7rem;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .scrubber-panel {
            background: #090f1d;
            border: 1px solid #1e293b;
            border-radius: 8px;
            padding: 14px 18px;
            margin-bottom: 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .scrubber-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .scrubber-controls {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-scrub {
            background: #1e293b;
            border: 1px solid #334155;
            color: #f8fafc;
            padding: 6px 14px;
            border-radius: 4px;
            font-size: 0.8rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-scrub:hover {
            background: #0284c7;
            border-color: #38bdf8;
        }

        .scrubber-slider {
            width: 100%;
            height: 6px;
            background: #1e293b;
            border-radius: 4px;
            outline: none;
            cursor: pointer;
            accent-color: #38bdf8;
        }

        .whatif-container {
            background: #0a0f1d;
            border: 1px solid #1f293d;
            border-radius: 8px;
            padding: 16px 20px;
            margin-top: 14px;
            margin-bottom: 25px;
        }

        .whatif-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.82rem;
            margin-top: 10px;
        }

        .whatif-table th {
            background: #131d2e;
            color: #94a3b8;
            padding: 8px 12px;
            text-align: left;
            border-bottom: 1px solid #1e293b;
        }

        .whatif-table td {
            padding: 8px 12px;
            border-bottom: 1px solid #162032;
            color: #cbd5e1;
        }
    
        /* Causal Replay HUD Overlays */
        .hud-card-inc {
            position: absolute;
            background: rgba(15, 23, 42, 0.90);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(51, 65, 85, 0.6);
            border-radius: 6px;
            padding: 8px 12px;
            font-family: 'JetBrains Mono', monospace, -apple-system;
            pointer-events: none;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            z-index: 15;
        }

        .hud-top-left-inc {
            top: 48px;
            left: 12px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 190px;
        }

        .hud-top-right-inc {
            top: 12px;
            right: 12px;
            text-align: right;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .hud-stat-row {
            display: flex;
            justify-content: space-between;
            font-size: 10.5px;
            gap: 8px;
        }

        .hud-clock-inc {
            font-size: 18px;
            font-weight: 700;
            color: #38bdf8;
            letter-spacing: -0.01em;
        }

        /* Floating Forensic Briefing Card */
        .hud-briefing-card-inc {
            position: absolute;
            bottom: 50px;
            right: 14px;
            max-width: 340px;
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(56, 189, 248, 0.45);
            border-left: 4px solid #38bdf8;
            border-radius: 8px;
            padding: 12px 14px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
            z-index: 20;
            font-family: 'Inter', -apple-system, sans-serif;
            pointer-events: auto;
            transition: all 0.2s ease;
        }

        .brief-badge {
            font-size: 9.5px;
            font-weight: 700;
            background: rgba(244, 63, 94, 0.2);
            color: #f43f5e;
            padding: 2px 6px;
            border-radius: 4px;
            border: 1px solid rgba(244, 63, 94, 0.4);
            font-family: monospace;
        }

        .speed-btn-group {
            display: inline-flex;
            gap: 4px;
            align-items: center;
        }

        .btn-speed {
            background: rgba(30, 41, 59, 0.7);
            border: 1px solid #334155;
            color: #94a3b8;
            font-family: monospace;
            font-size: 11px;
            padding: 4px 8px;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.15s;
        }

        .btn-speed:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.08);
        }

        .btn-speed.active {
            background: rgba(56, 189, 248, 0.25);
            border-color: #38bdf8;
            color: #38bdf8;
            font-weight: 700;
        }
    
    </style>
</head>
<body>

    <div class="header">
        <div>
            <div class="brand-title">CYBERFORGE EXECUTIVE INCIDENT DOSSIER</div>
            <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">
                Interactive Neo4j-Style Attack Graph, Causal Timelines & Predictive Blast Radius
            </div>
        </div>
        <div style="display: flex; align-items: center; gap: 18px;">
            <a href="/causal" target="_blank" style="text-decoration: none; background: linear-gradient(135deg, #2563eb, #7c3aed); color: #fff; padding: 8px 16px; border-radius: 6px; font-weight: 700; font-size: 0.85rem; box-shadow: 0 0 16px rgba(37,99,235,0.4); display: inline-flex; align-items: center; gap: 8px; border: 1px solid rgba(255,255,255,0.2); transition: all 0.15s ease;">
                <span>⚡</span> Launch Causal Replay Engine &rarr;
            </a>
            <div style="text-align: right;">
                <div style="font-size: 0.85rem; font-weight: 700; color: #fff;">Telemetry: Core (15 GB Profile)</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Generated: {{ generated_at }}</div>
            </div>
        </div>
    </div>

    <!-- KPI Summary Bar -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-val">{{ "{:,}".format(total_events) }}</div>
            <div class="kpi-lbl">Total Events Ingested</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-val">{{ "{:,}".format(total_alerts) }}</div>
            <div class="kpi-lbl">Detections Flagged</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-val">{{ "{:,}".format(total_incidents) }}</div>
            <div class="kpi-lbl">4D Correlated Incidents</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-val" style="color: var(--accent-red);">{{ peak_risk_score }} / 100</div>
            <div class="kpi-lbl">Peak Threat Risk Score</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-val" style="color: var(--accent-emerald);">&lt; 1 ms</div>
            <div class="kpi-lbl">Lookahead Query Latency</div>
        </div>
    </div>

    <!-- Executive Threat Rankings & Jump Bar -->
    <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 18px 24px; margin-bottom: 25px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
            <div style="font-size: 0.95rem; font-weight: 700; color: #fff;">
                Ranked Threat Index &bull; Top Incidents by Risk Score
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">
                Click any card to jump directly to its attack graph &amp; timeline
            </div>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px;">
            {% for inc in top_incidents %}
            <a href="#incident-{{ inc.incident_id }}" style="text-decoration: none; color: inherit;">
                <div style="background: #090e17; border: 1px solid {% if inc.risk_score >= 90 %}#ef444466{% else %}#f59e0b66{% endif %}; border-radius: 6px; padding: 12px 14px; transition: border-color 0.2s; cursor: pointer;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-weight: 800; color: #fff; font-size: 0.9rem;">#{{ loop.index }} Incident #{{ inc.incident_id }}</span>
                        <span style="font-weight: 800; font-size: 0.95rem; color: {% if inc.risk_score >= 90 %}var(--accent-red){% else %}var(--accent-amber){% endif %};">
                            {{ inc.risk_score }} / 100
                        </span>
                    </div>
                    <div style="font-family: monospace; font-size: 0.82rem; color: var(--accent-cyan); margin-top: 4px;">
                        {{ inc.root_entity }}
                    </div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">
                        {{ inc.alert_count }} alerts &bull; {{ inc.stages_covered.split(',') | length }} stages
                    </div>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>

    <!-- Top Correlated Incidents Dossiers -->
    {% for inc in top_incidents %}
    <div class="incident-dossier" id="incident-{{ inc.incident_id }}">
        <div class="dossier-header">
            <div class="dossier-title">
                <span>Incident #{{ inc.incident_id }}: {{ inc.title }}</span>
                <span class="badge badge-{{ inc.severity }}">{{ inc.severity }}</span>
            </div>
            <div style="text-align: right;">
                <span style="font-size: 1.1rem; font-weight: 800; color: {% if inc.risk_score >= 85 %}var(--accent-red){% else %}var(--accent-amber){% endif %};">
                    RISK SCORE: {{ inc.risk_score }} / 100
                </span>
            </div>
        </div>

        <!-- Meta Strip -->
        <div class="meta-strip">
            <div><span style="color: var(--text-muted);">Compromised Host:</span> <strong style="color: #fff;">{{ inc.root_entity }}</strong></div>
            <div><span style="color: var(--text-muted);">Attributed User:</span> <strong style="color: var(--accent-amber);">{{ inc.usr }}</strong></div>
            <div><span style="color: var(--text-muted);">Adversary Threat Actor IP:</span> <strong style="color: var(--accent-red);">{{ inc.adversary_ip }}</strong></div>
            <div><span style="color: var(--text-muted);">Campaign Duration:</span> <strong style="color: #fff;">{{ inc.duration_minutes }} min</strong></div>
        </div>

        <!-- EXECUTIVE INCIDENT BRIEFING (PLAIN ENGLISH NARRATIVE) -->
        {% if inc.narrative %}
        <div style="background: rgba(15, 23, 42, 0.95); border: 1px solid #1e293b; border-left: 4px solid var(--accent-cyan); border-radius: 6px; padding: 16px 20px; margin-bottom: 22px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font-weight: 700; font-size: 0.95rem; color: #fff; display: flex; align-items: center; gap: 8px;">
                    <span>📝</span> Executive Threat Briefing (Plain English)
                </span>
                <span style="font-size: 0.72rem; color: var(--accent-cyan); text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">
                    Auto-Generated Narrative
                </span>
            </div>
            <p style="color: #cbd5e1; font-size: 0.9rem; line-height: 1.6; margin-bottom: 12px;">
                {{ inc.narrative.summary }}
            </p>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 10px; margin-top: 10px;">
                {% for step in inc.narrative.story_steps %}
                <div style="background: #090e17; border: 1px solid #1f293d; border-radius: 4px; padding: 10px 12px;">
                    <div style="font-weight: 700; font-size: 0.8rem; color: var(--accent-amber); margin-bottom: 4px;">
                        {{ step.stage }}
                    </div>
                    <div style="font-size: 0.78rem; color: #94a3b8; line-height: 1.4;">
                        {{ step.narrative }}
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <!-- TEMPORAL METRICS & ATTACK VELOCITY STRIP -->
        {% if inc.temporal %}
        <div class="temporal-strip">
            <div class="temporal-card">
                <div class="temporal-lbl">Observed Attack Cadence</div>
                <div class="temporal-val">1 hop / {{ inc.temporal.cadence_median_min }}m</div>
                <div style="font-size: 0.73rem; color: #38bdf8; margin-top: 3px;">
                    Trend: <strong>{{ inc.temporal.cadence_trend }}</strong>
                </div>
            </div>
            <div class="temporal-card">
                <div class="temporal-lbl">Time-to-Domain-Compromise (TTDC)</div>
                <div class="temporal-val" style="color: #f43f5e;">P50: {{ inc.temporal.ttdc_p50_min }}m</div>
                <div style="font-size: 0.73rem; color: #94a3b8; margin-top: 3px;">
                    80% Interval: {{ inc.temporal.ttdc_p10_min }}m &mdash; {{ inc.temporal.ttdc_p90_min }}m
                </div>
            </div>
            <div class="temporal-card">
                <div class="temporal-lbl">Campaign Dwell Time</div>
                <div class="temporal-val" style="color: #f59e0b;">{{ inc.duration_minutes }} min</div>
                <div style="font-size: 0.73rem; color: #94a3b8; margin-top: 3px;">
                    Replayable in 30s (~15 min/s)
                </div>
            </div>
            <div class="temporal-card">
                <div class="temporal-lbl">Temporal Risk Velocity</div>
                <div class="temporal-val" id="risk-display-{{ inc.incident_id }}" style="color: var(--accent-red);">
                    {{ inc.risk_score }} / 100
                </div>
                <div style="font-size: 0.73rem; color: #fca5a5; margin-top: 3px;" id="state-summary-{{ inc.incident_id }}">
                    Compounding Threat Frontier
                </div>
            </div>
        </div>

        <!-- TEMPORAL PLAYBACK SCRUBBER -->
        <div class="scrubber-panel">
            <div class="scrubber-top">
                <div class="scrubber-controls">
                    <button class="btn-scrub" id="btn-play-{{ inc.incident_id }}" onclick="togglePlay('{{ inc.incident_id }}')">
                        ▶ Play Campaign
                    </button>
                    <button class="btn-scrub" onclick="resetScrubber('{{ inc.incident_id }}')">
                        ↺ Reset
                    </button>
                    <!-- Presenter Milestone Hop Stepper -->
                    <button class="btn-scrub" onclick="stepPrevHop('{{ inc.incident_id }}')" title="Previous Critical Hop (Left Arrow)">
                        ⏮ Prev Hop
                    </button>
                    <button class="btn-scrub" onclick="stepNextHop('{{ inc.incident_id }}')" title="Next Critical Hop (Right Arrow)">
                        Next Hop ⏭
