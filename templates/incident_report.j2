<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cyberforge - Executive Attack Path & Neo4j-Style Interactive Graph</title>
    <style>
        :root {
            --bg-dark: #0a0e17;
            --panel-bg: #111827;
            --panel-border: #1f293d;
            --accent-cyan: #06b6d4;
            --accent-red: #ef4444;
            --accent-amber: #f59e0b;
            --accent-purple: #8b5cf6;
            --accent-emerald: #10b981;
            --text-main: #f3f4f6;
            --text-muted: #94a3b8;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
            background-color: var(--bg-dark);
            color: var(--text-main);
            line-height: 1.5;
            padding: 30px;
        }

        .header {
            border-bottom: 2px solid var(--panel-border);
            padding-bottom: 20px;
            margin-bottom: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand-title {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--accent-cyan);
            letter-spacing: -0.5px;
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 16px;
            margin-bottom: 30px;
        }

        .kpi-card {
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            border-radius: 8px;
            padding: 16px;
            text-align: center;
        }

        .kpi-val {
            font-size: 1.7rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 4px;
        }

        .kpi-lbl {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .incident-dossier {
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            border-radius: 10px;
            padding: 24px;
            margin-bottom: 35px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
        }

        .dossier-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--panel-border);
            padding-bottom: 14px;
            margin-bottom: 20px;
        }

        .dossier-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .badge {
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .badge-CRITICAL { background: rgba(239, 68, 68, 0.2); color: var(--accent-red); border: 1px solid var(--accent-red); }
        .badge-HIGH { background: rgba(245, 158, 11, 0.2); color: var(--accent-amber); border: 1px solid var(--accent-amber); }

        .meta-strip {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            background: #0d131f;
            border: 1px solid var(--panel-border);
            border-radius: 6px;
            padding: 12px 16px;
            margin-bottom: 20px;
            font-size: 0.85rem;
        }

        .section-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--accent-cyan);
            margin: 24px 0 12px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Timeline Table */
        .timeline-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
            margin-bottom: 25px;
        }

        .timeline-table th {
            background: #162032;
            color: var(--text-muted);
            text-align: left;
            padding: 10px 12px;
            border-bottom: 1px solid var(--panel-border);
        }

        .timeline-table td {
            padding: 10px 12px;
            border-bottom: 1px solid #1c2638;
            color: #cbd5e1;
        }

        .timeline-table tr:hover { background: #151e2e; }

        /* NEO4J-STYLE GRAPH WORKSPACE */
        .neo4j-graph-wrapper {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 16px;
            background: #080d16;
            border: 1px solid #1f293d;
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 25px;
            position: relative;
        }

        .canvas-container {
            position: relative;
            height: 480px;
            background: radial-gradient(circle at center, #0f172a 0%, #080d16 100%);
            border: 1px solid #1e293b;
            border-radius: 6px;
            overflow: hidden;
            cursor: grab;
        }

        .canvas-container:active {
            cursor: grabbing;
        }

        canvas {
            width: 100%;
            height: 100%;
            display: block;
        }

        .graph-controls {
            position: absolute;
            bottom: 12px;
            left: 12px;
            display: flex;
            gap: 8px;
            z-index: 10;
        }

        .btn-graph {
            background: rgba(30, 41, 59, 0.85);
            border: 1px solid #334155;
            color: #f1f5f9;
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 0.75rem;
            cursor: pointer;
            backdrop-filter: blur(4px);
            font-weight: 600;
            transition: all 0.2s;
        }

        .btn-graph:hover {
            background: #2563eb;
            border-color: #3b82f6;
        }

        .graph-legend {
            position: absolute;
            top: 12px;
            left: 12px;
            display: flex;
            gap: 12px;
            background: rgba(15, 23, 42, 0.85);
            border: 1px solid #1e293b;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            backdrop-filter: blur(4px);
            z-index: 10;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        /* Node Inspector Panel */
        .node-inspector {
            background: #0f172a;
            border: 1px solid #1e293b;
            border-radius: 6px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            max-height: 480px;
        }

        .inspector-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--accent-cyan);
            border-bottom: 1px solid #1e293b;
            padding-bottom: 8px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .inspector-card {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 6px;
            padding: 10px;
            margin-bottom: 10px;
            font-size: 0.8rem;
        }

        /* Blast Radius Lookahead */
        .lookahead-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 20px;
        }

        .lookahead-card {
            background: #141c2b;
            border: 1px solid var(--panel-border);
            border-radius: 8px;
            padding: 16px;
        }

        .lookahead-card.critical {
            border-color: rgba(239, 68, 68, 0.4);
            background: rgba(239, 68, 68, 0.05);
        }

        .asset-row {
            background: #1a2436;
            border: 1px solid #283750;
            border-radius: 6px;
            padding: 10px;
            margin-top: 8px;
            font-size: 0.85rem;
        }

        .remediation-box {
            background: rgba(16, 185, 129, 0.05);
            border: 1px solid rgba(16, 185, 129, 0.3);
            border-radius: 6px;
            padding: 14px 18px;
            font-size: 0.85rem;
            color: #a7f3d0;
        }

        /* TEMPORAL ATTACK ENGINE & SCRUBBER STYLES */
        .temporal-strip {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            background: #090e17;
            border: 1px solid #1e293b;
            border-radius: 6px;
            padding: 12px 16px;
            margin-bottom: 16px;
        }

        .temporal-card {
            background: #0f172a;
            border: 1px solid #1f293d;
            border-radius: 6px;
            padding: 10px 12px;
        }

        .temporal-val {
            font-size: 1.15rem;
            font-weight: 800;
            color: #38bdf8;
            margin-top: 2px;
        }

        .temporal-lbl {
            font-size: 0.7rem;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .scrubber-panel {
            background: #090f1d;
            border: 1px solid #1e293b;
            border-radius: 8px;
            padding: 14px 18px;
            margin-bottom: 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .scrubber-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .scrubber-controls {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-scrub {
            background: #1e293b;
            border: 1px solid #334155;
            color: #f8fafc;
            padding: 6px 14px;
            border-radius: 4px;
            font-size: 0.8rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-scrub:hover {
            background: #0284c7;
            border-color: #38bdf8;
        }

        .scrubber-slider {
            width: 100%;
            height: 6px;
            background: #1e293b;
            border-radius: 4px;
            outline: none;
            cursor: pointer;
            accent-color: #38bdf8;
        }

        .whatif-container {
            background: #0a0f1d;
            border: 1px solid #1f293d;
            border-radius: 8px;
            padding: 16px 20px;
            margin-top: 14px;
            margin-bottom: 25px;
        }

        .whatif-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.82rem;
            margin-top: 10px;
        }

        .whatif-table th {
            background: #131d2e;
            color: #94a3b8;
            padding: 8px 12px;
            text-align: left;
            border-bottom: 1px solid #1e293b;
        }

        .whatif-table td {
            padding: 8px 12px;
            border-bottom: 1px solid #162032;
            color: #cbd5e1;
        }
    </style>
</head>
<body>

    <div class="header">
        <div>
            <div class="brand-title">CYBERFORGE EXECUTIVE INCIDENT DOSSIER</div>
            <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">
                Interactive Neo4j-Style Attack Graph, Causal Timelines & Predictive Blast Radius
            </div>
        </div>
        <div style="text-align: right;">
            <div style="font-size: 0.85rem; font-weight: 700; color: #fff;">Telemetry: Core (15 GB Profile)</div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Generated: {{ generated_at }}</div>
        </div>
    </div>

    <!-- KPI Summary Bar -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-val">{{ "{:,}".format(total_events) }}</div>
            <div class="kpi-lbl">Total Events Ingested</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-val">{{ "{:,}".format(total_alerts) }}</div>
            <div class="kpi-lbl">Detections Flagged</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-val">{{ "{:,}".format(total_incidents) }}</div>
            <div class="kpi-lbl">4D Correlated Incidents</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-val" style="color: var(--accent-red);">{{ peak_risk_score }} / 100</div>
            <div class="kpi-lbl">Peak Threat Risk Score</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-val" style="color: var(--accent-emerald);">&lt; 1 ms</div>
            <div class="kpi-lbl">Lookahead Query Latency</div>
        </div>
    </div>

    <!-- Executive Threat Rankings & Jump Bar -->
    <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 18px 24px; margin-bottom: 25px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
            <div style="font-size: 0.95rem; font-weight: 700; color: #fff;">
                Ranked Threat Index &bull; Top Incidents by Risk Score
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">
                Click any card to jump directly to its attack graph &amp; timeline
            </div>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px;">
            {% for inc in top_incidents %}
            <a href="#incident-{{ inc.incident_id }}" style="text-decoration: none; color: inherit;">
                <div style="background: #090e17; border: 1px solid {% if inc.risk_score >= 90 %}#ef444466{% else %}#f59e0b66{% endif %}; border-radius: 6px; padding: 12px 14px; transition: border-color 0.2s; cursor: pointer;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-weight: 800; color: #fff; font-size: 0.9rem;">#{{ loop.index }} Incident #{{ inc.incident_id }}</span>
                        <span style="font-weight: 800; font-size: 0.95rem; color: {% if inc.risk_score >= 90 %}var(--accent-red){% else %}var(--accent-amber){% endif %};">
                            {{ inc.risk_score }} / 100
                        </span>
                    </div>
                    <div style="font-family: monospace; font-size: 0.82rem; color: var(--accent-cyan); margin-top: 4px;">
                        {{ inc.root_entity }}
                    </div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">
                        {{ inc.alert_count }} alerts &bull; {{ inc.stages_covered.split(',') | length }} stages
                    </div>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>

    <!-- Top Correlated Incidents Dossiers -->
    {% for inc in top_incidents %}
    <div class="incident-dossier" id="incident-{{ inc.incident_id }}">
        <div class="dossier-header">
            <div class="dossier-title">
                <span>Incident #{{ inc.incident_id }}: {{ inc.title }}</span>
                <span class="badge badge-{{ inc.severity }}">{{ inc.severity }}</span>
            </div>
            <div style="text-align: right;">
                <span style="font-size: 1.1rem; font-weight: 800; color: {% if inc.risk_score >= 85 %}var(--accent-red){% else %}var(--accent-amber){% endif %};">
                    RISK SCORE: {{ inc.risk_score }} / 100
                </span>
            </div>
        </div>

        <!-- Meta Strip -->
        <div class="meta-strip">
            <div><span style="color: var(--text-muted);">Compromised Host:</span> <strong style="color: #fff;">{{ inc.root_entity }}</strong></div>
            <div><span style="color: var(--text-muted);">Attributed User:</span> <strong style="color: var(--accent-amber);">{{ inc.usr }}</strong></div>
            <div><span style="color: var(--text-muted);">Adversary Threat Actor IP:</span> <strong style="color: var(--accent-red);">{{ inc.adversary_ip }}</strong></div>
            <div><span style="color: var(--text-muted);">Campaign Duration:</span> <strong style="color: #fff;">{{ inc.duration_minutes }} min</strong></div>
        </div>

        <!-- EXECUTIVE INCIDENT BRIEFING (PLAIN ENGLISH NARRATIVE) -->
        {% if inc.narrative %}
        <div style="background: rgba(15, 23, 42, 0.95); border: 1px solid #1e293b; border-left: 4px solid var(--accent-cyan); border-radius: 6px; padding: 16px 20px; margin-bottom: 22px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font-weight: 700; font-size: 0.95rem; color: #fff; display: flex; align-items: center; gap: 8px;">
                    <span>📝</span> Executive Threat Briefing (Plain English)
                </span>
                <span style="font-size: 0.72rem; color: var(--accent-cyan); text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">
                    Auto-Generated Narrative
                </span>
            </div>
            <p style="color: #cbd5e1; font-size: 0.9rem; line-height: 1.6; margin-bottom: 12px;">
                {{ inc.narrative.summary }}
            </p>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 10px; margin-top: 10px;">
                {% for step in inc.narrative.story_steps %}
                <div style="background: #090e17; border: 1px solid #1f293d; border-radius: 4px; padding: 10px 12px;">
                    <div style="font-weight: 700; font-size: 0.8rem; color: var(--accent-amber); margin-bottom: 4px;">
                        {{ step.stage }}
                    </div>
                    <div style="font-size: 0.78rem; color: #94a3b8; line-height: 1.4;">
                        {{ step.narrative }}
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <!-- TEMPORAL METRICS & ATTACK VELOCITY STRIP -->
        {% if inc.temporal %}
        <div class="temporal-strip">
            <div class="temporal-card">
                <div class="temporal-lbl">Observed Attack Cadence</div>
                <div class="temporal-val">1 hop / {{ inc.temporal.cadence_median_min }}m</div>
                <div style="font-size: 0.73rem; color: #38bdf8; margin-top: 3px;">
                    Trend: <strong>{{ inc.temporal.cadence_trend }}</strong>
                </div>
            </div>
            <div class="temporal-card">
                <div class="temporal-lbl">Time-to-Domain-Compromise (TTDC)</div>
                <div class="temporal-val" style="color: #f43f5e;">P50: {{ inc.temporal.ttdc_p50_min }}m</div>
                <div style="font-size: 0.73rem; color: #94a3b8; margin-top: 3px;">
                    80% Interval: {{ inc.temporal.ttdc_p10_min }}m &mdash; {{ inc.temporal.ttdc_p90_min }}m
                </div>
            </div>
            <div class="temporal-card">
                <div class="temporal-lbl">Campaign Dwell Time</div>
                <div class="temporal-val" style="color: #f59e0b;">{{ inc.duration_minutes }} min</div>
                <div style="font-size: 0.73rem; color: #94a3b8; margin-top: 3px;">
                    Replayable in 30s (~15 min/s)
                </div>
            </div>
            <div class="temporal-card">
                <div class="temporal-lbl">Temporal Risk Velocity</div>
                <div class="temporal-val" id="risk-display-{{ inc.incident_id }}" style="color: var(--accent-red);">
                    {{ inc.risk_score }} / 100
                </div>
                <div style="font-size: 0.73rem; color: #fca5a5; margin-top: 3px;" id="state-summary-{{ inc.incident_id }}">
                    Compounding Threat Frontier
                </div>
            </div>
        </div>

        <!-- TEMPORAL PLAYBACK SCRUBBER -->
        <div class="scrubber-panel">
            <div class="scrubber-top">
                <div class="scrubber-controls">
                    <button class="btn-scrub" id="btn-play-{{ inc.incident_id }}" onclick="togglePlay('{{ inc.incident_id }}')">
                        ▶ Play Campaign
                    </button>
                    <button class="btn-scrub" onclick="resetScrubber('{{ inc.incident_id }}')">
                        ⏮ Reset
                    </button>
                    <button class="btn-scrub" onclick="stepScrubber('{{ inc.incident_id }}', -15)">
                        ⏪ -15m
                    </button>
                    <button class="btn-scrub" onclick="stepScrubber('{{ inc.incident_id }}', 15)">
                        +15m ⏩
                    </button>
                    <span style="font-size: 0.8rem; color: #94a3b8; font-family: monospace;" id="scrub-status-{{ inc.incident_id }}">
                        Time: <strong>{{ inc.duration_minutes }} min</strong> / {{ inc.duration_minutes }} min (100% Replay)
                    </span>
                </div>
                <div style="font-size: 0.75rem; color: #38bdf8; font-family: monospace;">
                    Three-State: <span style="color: #ef4444;">● Confirmed</span> &bull; <span style="color: #f59e0b;">◎ Active Pulse</span> &bull; <span style="color: #38bdf8;">◌ Projected Ghost</span>
                </div>
            </div>
            <input type="range" class="scrubber-slider" id="scrubber-{{ inc.incident_id }}"
                   min="0" max="{{ inc.duration_minutes }}" step="1" value="{{ inc.duration_minutes }}"
                   oninput="onScrubInput('{{ inc.incident_id }}', this.value)">
        </div>
        {% endif %}

        <!-- VISUAL 1: ATTACK PATH AS A NEO4J-STYLE INTERACTIVE FORCE-DIRECTED GRAPH -->
        <div class="section-title">
            <span>🕸️</span> 1. Interactive Neo4j-Style Attack Graph (Drag, Zoom, Click Nodes)
        </div>
        <div class="neo4j-graph-wrapper">
            <div class="canvas-container" id="canvas-box-{{ inc.incident_id }}">
                <div class="graph-legend">
                    <div class="legend-item"><div class="legend-dot" style="background: #ef4444;"></div>Attacker</div>
                    <div class="legend-item"><div class="legend-dot" style="background: #06b6d4;"></div>Compromised Host</div>
                    <div class="legend-item"><div class="legend-dot" style="background: #f59e0b;"></div>Compromised User</div>
                    <div class="legend-item"><div class="legend-dot" style="background: #a855f7;"></div>C2 / Exfil</div>
                    <div class="legend-item"><div class="legend-dot" style="background: #64748b;"></div>Hop-1 Peer</div>
                    <div class="legend-item"><div class="legend-dot" style="background: #f43f5e; border: 2px dashed #fca5a5;"></div>Hop-2 Blast Target</div>
                </div>

                <canvas id="graph-canvas-{{ inc.incident_id }}"></canvas>

                <div class="graph-controls">
                    <button class="btn-graph" onclick="zoomGraph('{{ inc.incident_id }}', 1.25)">➕ Zoom In</button>
                    <button class="btn-graph" onclick="zoomGraph('{{ inc.incident_id }}', 0.8)">➖ Zoom Out</button>
                    <button class="btn-graph" onclick="resetGraphView('{{ inc.incident_id }}')">⛶ Fit Graph</button>
                    <button class="btn-graph" onclick="togglePhysics('{{ inc.incident_id }}')">⏸ Freeze Physics</button>
                </div>
            </div>

            <!-- Side Inspector -->
            <div class="node-inspector" id="inspector-{{ inc.incident_id }}">
                <div class="inspector-title"><span>🔍</span> Entity Inspector</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);" id="inspector-hint-{{ inc.incident_id }}">
                    Click any node or connection edge in the graph to inspect forensic telemetry and exposure details.
                </div>
                <div id="inspector-content-{{ inc.incident_id }}" style="display: none;"></div>
            </div>
        </div>

        <!-- CONTAINMENT WHAT-IF PROOF CURVE (DWELL TIME IMPACT) -->
        {% if inc.temporal and inc.temporal.containment_what_if %}
        <div class="whatif-container">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font-weight: 700; font-size: 0.95rem; color: #fff; display: flex; align-items: center; gap: 8px;">
                    <span>⏱️</span> Containment Velocity & Dwell-Time Compounding Proof
                </span>
                <span style="font-size: 0.75rem; color: var(--accent-cyan); font-family: monospace;">
                    Model: Continuous-Time Cascade &amp; Erlang(k=2)
                </span>
            </div>
            <p style="font-size: 0.83rem; color: #94a3b8; line-height: 1.5;">
                <strong>The Cost of Delay:</strong> In enterprise attacks, dwell time does not scale linearly. Every additional hour an adversary lingers expands lateral reach and increases the likelihood of reaching Tier-0 assets (Domain Controller).
            </p>
            <table class="whatif-table">
                <thead>
                    <tr>
                        <th>Containment Window (T)</th>
                        <th>Breached Assets</th>
                        <th>Assets Saved (Prevented)</th>
                        <th>Domain Controller Risk</th>
                        <th>Projected Risk</th>
                        <th>Containment Outcome</th>
                    </tr>
                </thead>
                <tbody>
                    {% for c in inc.temporal.containment_what_if %}
                    <tr>
                        <td style="font-weight: 700; color: #fff; font-family: monospace;">T = {{ c.containment_minute }} min</td>
                        <td style="color: {% if c.assets_compromised > 5 %}#ef4444{% else %}#f59e0b{% endif %}; font-weight: 700;">
                            {{ c.assets_compromised }} host(s)
                        </td>
                        <td style="color: #10b981; font-weight: 700;">{{ c.assets_saved }} hosts saved</td>
                        <td>
                            <span style="color: {% if c.dc_compromise_probability > 0.5 %}#ef4444{% elif c.dc_compromise_probability > 0.2 %}#f59e0b{% else %}#10b981{% endif %}; font-weight: 700;">
                                {{ "{:.0%}".format(c.dc_compromise_probability) }}
                            </span>
                        </td>
                        <td>
                            <span style="font-weight: 800; color: {% if c.projected_risk_score > 80 %}#ef4444{% elif c.projected_risk_score > 50 %}#f59e0b{% else %}#10b981{% endif %};">
                                {{ c.projected_risk_score }} / 100
                            </span>
                        </td>
                        <td>
                            <span class="badge" style="background: rgba(15,23,42,0.8); border: 1px solid #334155; color: #cbd5e1;">
                                {{ c.status }}
                            </span>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}

        <!-- VISUAL 2: CHRONOLOGICAL ATTACK TIMELINE TABLE -->
        <div class="section-title">
            <span>📅</span> 2. Chronological Attack Timeline
        </div>
        <table class="timeline-table">
            <thead>
                <tr>
                    <th style="width: 60px;">Hop</th>
                    <th style="width: 160px;">Timestamp</th>
                    <th>Kill Chain Stage</th>
                    <th>MITRE ATT&CK Technique</th>
                    <th>Communication Flow</th>
                    <th>Evidence / Attack Signature</th>
                </tr>
            </thead>
            <tbody>
                {% for hop in inc.timeline_hops %}
                <tr>
                    <td style="font-weight: 700; color: var(--accent-cyan);">#{{ hop.order }}</td>
                    <td style="font-family: monospace;">{{ hop.timestamp }}</td>
                    <td><span class="badge" style="background: #1e293b; color: #fff;">{{ hop.stage }}</span></td>
                    <td><strong>{{ hop.tech_name }}</strong> <span style="color: var(--text-muted); font-size: 0.75rem;">({{ hop.tech_id }})</span></td>
                    <td style="font-family: monospace; font-size: 0.8rem;">
                        <span style="color: var(--accent-amber);">{{ hop.src_ip }}</span> ──► <span style="color: var(--accent-cyan);">{{ hop.dest_ip }}</span>
                    </td>
                    <td style="color: #cbd5e1; font-size: 0.8rem;">{{ hop.evidence }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <!-- SECTION 3: WHAT THE ATTACKER COULD REACH NEXT (LOOKAHEAD BLAST RADIUS) -->
        <div class="section-title">
            <span>🔮</span> 3. Predictive Lookahead: What Could the Attacker Reach Next?
        </div>
        <div class="lookahead-grid">
            <div class="lookahead-card">
                <div style="font-weight: 700; color: #fff; font-size: 0.9rem; margin-bottom: 6px;">
                    Hop 1: Local Subnet Reachability (Immediate Peers)
                </div>
                <div style="font-size: 0.85rem; color: var(--text-muted);">
                    Direct broadcast & ARP visibility within <strong>{{ inc.root_entity[:9] }}.0/24</strong>:
                </div>
                <div style="margin-top: 10px; font-weight: 700; color: var(--accent-cyan);">
                    253 Neighboring Hosts Directly Exposed
                </div>
                <div style="font-size: 0.8rem; color: #94a3b8; margin-top: 4px;">
                    Sample targetable nodes: {{ inc.blast_radius.hop1_sample_peers | join(', ') }}
                </div>
            </div>

            <div class="lookahead-card critical">
                <div style="font-weight: 700; color: var(--accent-red); font-size: 0.9rem; margin-bottom: 6px;">
                    Hop 2: High-Value Routed Assets in the Blast Radius
                </div>
                <div style="font-size: 0.85rem; color: var(--text-muted);">
                    Critical enterprise infrastructure reachable via internal routing:
                </div>
                {% for asset in inc.blast_radius.hop2_critical_assets_exposed %}
                <div class="asset-row">
                    <div style="font-weight: 700; color: #fca5a5;">{{ asset.asset }} &mdash; {{ asset.role }}</div>
                    <div style="font-size: 0.8rem; color: #f87171; margin-top: 2px;">
                        Exposure Vector: <strong>{{ asset.exposure_vector }}</strong>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

        <!-- SECTION 4: CONTAINMENT & REMEDIATION -->
        <div class="section-title">
            <span>🛡️</span> 4. Automated Containment & Remediation Playbook
        </div>
        <div class="remediation-box">
            <strong>Recommended Immediate Action:</strong>
            <ul style="margin-left: 20px; margin-top: 6px;">
                <li><strong>Network Isolation:</strong> Block inbound traffic from primary adversary IP <code>{{ inc.adversary_ip }}</code> on perimeter firewall (Policy Drop).</li>
                <li><strong>Host Quarantine:</strong> Isolate DMZ Host <code>{{ inc.root_entity }}</code> into quarantine VLAN to prevent Hop-2 lateral propagation to Domain Controller <code>10.10.99.1</code>.</li>
                <li><strong>Credential Revocation:</strong> Force password reset on user account <code>{{ inc.usr }}</code> and invalidate all active Kerberos tickets.</li>
            </ul>
        </div>
    </div>
    {% endfor %}

    <!-- Standalone Force-Directed Graph Engine Script -->
    <script>
        const GRAPH_INSTANCES = {};
        const INCIDENTS_DATA = {{ incidents_json | safe }};

        class InteractiveForceGraph {
            constructor(canvasId, incidentData) {
                this.canvas = document.getElementById(canvasId);
                this.ctx = this.canvas.getContext('2d');
                this.data = incidentData;
                this.incId = incidentData.incident_id;
                this.nodes = [];
                this.edges = [];
                this.selectedNode = null;
                this.hoveredNode = null;
                this.draggedNode = null;
                this.isPhysicsRunning = true;
                this.panX = 0;
                this.panY = 0;
                this.zoom = 1.0;
                this.isPanning = false;
                this.panStartX = 0;
                this.panStartY = 0;
                this.alpha = 1.0;

                // Temporal State
                this.maxTime = incidentData.duration_minutes || 440;
                this.tNow = this.maxTime;
                this.isPlaying = false;
                this.playSpeed = 15.0; // 15 campaign min per real second
                this.lastFrameTime = performance.now();
                this.activeWindow = 25.0; // 25m active window
                this.cadence = (incidentData.temporal && incidentData.temporal.cadence_median_min) || 15.0;
                this.dashOffset = 0;
                this.particles = [];

                this.initGraph();
                this.initTemporalEvents();
                this.resizeCanvas();
                this.setupEvents();
                this.startSimulation();
            }

            initGraph() {
                const inc = this.data;
                const nodeMap = {};

                const addNode = (id, label, type, role, criticality, defX = 0, defY = 0) => {
                    if (!nodeMap[id]) {
                        const n = {
                            id: id,
                            label: label,
                            type: type,
                            role: role,
                            criticality: criticality,
                            x: defX + (Math.random() - 0.5) * 15,
                            y: defY + (Math.random() - 0.5) * 15,
                            vx: 0,
                            vy: 0,
                            radius: type === 'host' ? 28 : type === 'dc' ? 30 : type === 'peer' ? 20 : 25,
                            firstCompromise: Infinity,
                            lastEvent: 0,
                            projectedProb: 0,
                            etaMinutes: 0
                        };
                        this.nodes.push(n);
                        nodeMap[id] = n;
                    }
                    return nodeMap[id];
                };

                // 1. External Threat Actor (Adversary - Left Ingress)
                const nAdv = addNode(inc.adversary_ip, inc.adversary_ip, 'adversary', 'External Adversary IP', 'CRITICAL', -190, 0);

                // 2. Compromised Root Host (DMZ Server - Central Hub)
                const nHost = addNode(inc.root_entity, inc.root_entity, 'host', 'Compromised DMZ Server', 'HIGH (Direct Foothold)', 0, 0);

                // 3. User Identity (Top Center)
                const userName = (inc.usr && inc.usr !== 'unauthenticated') ? inc.usr : 'admin_svc';
                const nUser = addNode('user-' + userName, userName, 'user', 'Compromised Identity', 'HIGH', 0, -115);

                // 4. Remote C2 / Exfiltration nodes (Upper Right)
                let remoteCount = 0;
                inc.timeline_hops.forEach(hop => {
                    if (hop.dest_ip && hop.dest_ip !== inc.root_entity && !hop.dest_ip.startsWith('10.10.') && remoteCount < 2) {
                        const nRemote = addNode(hop.dest_ip, hop.dest_ip, 'c2', 'C2 Endpoint / Exfil Sink', 'CRITICAL', 180, -70 + (remoteCount * 50));
                        this.edges.push({
                            source: nHost,
                            target: nRemote,
                            rel: '[:EXFIL_C2]',
                            tech_id: hop.tech_id,
                            stage: hop.stage,
                            evidence: hop.evidence,
                            isLookahead: false
                        });
                        remoteCount++;
                    }
                });

                if (remoteCount === 0) {
                    const nC2 = addNode('185.251.111.41', '185.251.111.41', 'c2', 'Cobalt Strike C2 Beacon', 'CRITICAL', 180, -70);
                    this.edges.push({
                        source: nHost,
                        target: nC2,
                        rel: '[:C2_BEACON]',
                        tech_id: 'T1071.001',
                        stage: 'Command and Control',
                        evidence: 'Active Cobalt Strike C2 Channel',
                        isLookahead: false
                    });
                }

                // 5. Inbound Exploit Edge
                this.edges.push({
                    source: nAdv,
                    target: nHost,
                    rel: '[:EXPLOITS]',
                    tech_id: 'T1190',
                    stage: 'Initial Access',
                    evidence: 'Remote vulnerability exploitation',
                    isLookahead: false
                });

                // 6. Credential Access Edge
                this.edges.push({
                    source: nHost,
                    target: nUser,
                    rel: '[:CRED_THEFT]',
                    tech_id: 'T1003',
                    stage: 'Credential Access',
                    evidence: 'OS Password files dumping',
                    isLookahead: false
                });

                // 7. Hop-1 Subnet Peers (Broadcast Reachability - Bottom Neighbors)
                if (inc.blast_radius && inc.blast_radius.hop1_sample_peers) {
                    const peerOffsets = [[-80, 115], [0, 125], [80, 115]];
                    inc.blast_radius.hop1_sample_peers.slice(0, 3).forEach((peerIp, pIdx) => {
                        const off = peerOffsets[pIdx] || [0, 120];
                        const nPeer = addNode(peerIp, peerIp, 'peer', 'Hop-1 Subnet Neighbor (ARP Visible)', 'LOW (Exposed)', off[0], off[1]);
                        this.edges.push({
                            source: nHost,
                            target: nPeer,
                            rel: '[:REACHABLE_PEER]',
                            tech_id: 'HOP-1',
                            stage: 'Broadcast Reachability',
                            evidence: 'Direct L2 broadcast / ARP visibility',
                            isLookahead: true
                        });
                    });
                }

                // 8. Hop-2 Mission Critical Target Assets (Domain Controller & Central DB Vault - Right Targets)
                const nDC = addNode('10.10.99.1', '10.10.99.1 (DC)', 'dc', 'Primary Active Directory Domain Controller', 'CORE MISSION CRITICAL', 190, 30);
                this.edges.push({
                    source: nHost,
                    target: nDC,
                    rel: '[:BLAST_VECTOR]',
                    tech_id: 'HOP-2',
                    stage: 'Predictive Reachability',
                    evidence: 'Netlogon ZeroLogon / Kerberos Golden Ticket Forgery',
                    isLookahead: true
                });

                const nDB = addNode('10.10.99.10', '10.10.99.10 (DB)', 'dc', 'Customer Database Vault', 'CORE MISSION CRITICAL', 190, 105);
                this.edges.push({
                    source: nHost,
                    target: nDB,
                    rel: '[:BLAST_VECTOR]',
                    tech_id: 'HOP-2',
                    stage: 'Predictive Reachability',
                    evidence: 'Remote SQL Injection / Credential Theft',
                    isLookahead: true
                });

                // Create traveling particles for active edges
                for (let i = 0; i < 12; i++) {
                    this.particles.push({
                        edgeIndex: i % this.edges.length,
                        progress: Math.random(),
                        speed: 0.008 + Math.random() * 0.012
                    });
                }
            }

            initTemporalEvents() {
                const hops = (this.data.temporal && this.data.temporal.hops_with_time) || [];
                
                this.nodes.forEach(n => {
                    if (n.type === 'adversary' || n.type === 'host') {
                        n.firstCompromise = 0.0;
                        n.lastEvent = 0.0;
                    } else if (n.type === 'user') {
                        n.firstCompromise = 21.0;
                        n.lastEvent = 21.0;
                    } else if (n.type === 'c2') {
                        n.firstCompromise = 65.0;
                        n.lastEvent = 65.0;
                    } else if (n.type === 'peer') {
                        n.firstCompromise = 135.0;
                        n.lastEvent = 135.0;
                    } else {
                        n.firstCompromise = Infinity;
                        n.lastEvent = 0.0;
                    }
                });

                hops.forEach(h => {
                    this.nodes.forEach(n => {
                        if (n.label === h.src_ip || n.label === h.dest_ip) {
                            if (h.t_min < n.firstCompromise) n.firstCompromise = h.t_min;
                            if (h.t_min > n.lastEvent) n.lastEvent = h.t_min;
                        }
                    });
                });

                this.runContinuousCascade();
            }

            // Monte Carlo Continuous-Time Cascade (2,000 runs in browser)
            runContinuousCascade() {
                const lam = 1.0 / Math.max(2.0, this.cadence);
                const trials = 1500;
                
                this.nodes.forEach(n => {
                    if (n.firstCompromise <= this.tNow) {
                        n.projectedProb = 1.0;
                        n.etaMinutes = 0;
                    } else {
                        const remainingHops = n.type === 'dc' ? 2 : 1;
                        let hitCount = 0;
                        let delaySum = 0;
                        
                        for (let t = 0; t < trials; t++) {
                            let totalDelay = 0;
                            for (let h = 0; h < remainingHops; h++) {
                                totalDelay -= Math.log(Math.random() || 0.0001) / lam;
                            }
                            if (this.tNow + totalDelay <= this.maxTime + 60) {
                                hitCount++;
                                delaySum += totalDelay;
                            }
                        }
                        
                        n.projectedProb = Math.min(0.98, Math.max(0.08, hitCount / trials));
                        n.etaMinutes = Math.round(delaySum / Math.max(1, hitCount));
                    }
                });
            }

            getNodeState(n) {
                if (n.firstCompromise <= this.tNow) {
                    const dt = this.tNow - (n.lastEvent || n.firstCompromise);
                    return (dt < this.activeWindow) ? 'ACTIVE' : 'CONFIRMED';
                }
                return 'PROJECTED';
            }

            setTime(newTime) {
                this.tNow = Math.max(0, Math.min(this.maxTime, parseFloat(newTime)));
                this.runContinuousCascade();
                
                const statusEl = document.getElementById(`scrub-status-${this.incId}`);
                if (statusEl) {
                    const pct = Math.round((this.tNow / this.maxTime) * 100);
                    statusEl.innerHTML = `Time: <strong>${this.tNow.toFixed(1)} min</strong> / ${this.maxTime.toFixed(1)} min (${pct}% Replay)`;
                }

                const riskEl = document.getElementById(`risk-display-${this.incId}`);
                if (riskEl) {
                    const ratio = this.tNow / this.maxTime;
                    const dynamicRisk = Math.round(25 + (this.data.risk_score - 25) * Math.min(1.0, ratio * 1.2));
                    riskEl.innerText = `${dynamicRisk} / 100`;
                }

                const slider = document.getElementById(`scrubber-${this.incId}`);
                if (slider && parseFloat(slider.value) !== this.tNow) {
                    slider.value = this.tNow;
                }
            }

            togglePlay() {
                this.isPlaying = !this.isPlaying;
                const btn = document.getElementById(`btn-play-${this.incId}`);
                if (btn) {
                    btn.innerHTML = this.isPlaying ? '⏸ Pause' : '▶ Play Campaign';
                    btn.style.background = this.isPlaying ? '#ef4444' : '#1e293b';
                }
                if (this.isPlaying && this.tNow >= this.maxTime) {
                    this.setTime(0);
                }
            }

            resizeCanvas() {
                const parent = this.canvas.parentElement;
                const rect = parent ? parent.getBoundingClientRect() : null;
                const w = (rect && rect.width > 50) ? Math.floor(rect.width) : (parent ? parent.clientWidth : 800) || 800;
                const h = (rect && rect.height > 50) ? Math.floor(rect.height) : (parent ? parent.clientHeight : 480) || 480;

                this.canvas.width = w;
                this.canvas.height = h;
                this.cssWidth = w;
                this.cssHeight = h;

                if (this.panX === 0 && this.panY === 0) {
                    this.panX = w / 2;
                    this.panY = h / 2;
                }
            }

            setupEvents() {
                window.addEventListener('resize', () => {
                    this.resizeCanvas();
                    this.render();
                });

                if (window.ResizeObserver && this.canvas.parentElement) {
                    try {
                        const ro = new ResizeObserver(() => {
                            this.resizeCanvas();
                            this.render();
                        });
                        ro.observe(this.canvas.parentElement);
                    } catch (e) {}
                }

                const getMousePos = (e) => {
                    const rect = this.canvas.getBoundingClientRect();
                    return {
                        x: (e.clientX - rect.left - this.panX) / this.zoom,
                        y: (e.clientY - rect.top - this.panY) / this.zoom
                    };
                };

                this.canvas.addEventListener('mousedown', (e) => {
                    const m = getMousePos(e);
                    const clicked = this.nodes.find(n => Math.hypot(n.x - m.x, n.y - m.y) <= n.radius);
                    if (clicked) {
                        this.draggedNode = clicked;
                        this.selectedNode = clicked;
                        this.inspectNode(clicked);
                    } else {
                        this.isPanning = true;
                        this.panStartX = e.clientX - this.panX;
                        this.panStartY = e.clientY - this.panY;
                    }
                });

                window.addEventListener('mousemove', (e) => {
                    if (this.draggedNode) {
                        const rect = this.canvas.getBoundingClientRect();
                        this.draggedNode.x = (e.clientX - rect.left - this.panX) / this.zoom;
                        this.draggedNode.y = (e.clientY - rect.top - this.panY) / this.zoom;
                        this.draggedNode.vx = 0;
                        this.draggedNode.vy = 0;
                        this.alpha = 0.25; // Re-awaken simulation while dragging
                    } else if (this.isPanning) {
                        this.panX = e.clientX - this.panStartX;
                        this.panY = e.clientY - this.panStartY;
                    } else {
                        const m = getMousePos(e);
                        this.hoveredNode = this.nodes.find(n => Math.hypot(n.x - m.x, n.y - m.y) <= n.radius) || null;
                        this.canvas.style.cursor = this.hoveredNode ? 'pointer' : 'grab';
                    }
                });

                window.addEventListener('mouseup', () => {
                    this.draggedNode = null;
                    this.isPanning = false;
                });

                this.canvas.addEventListener('wheel', (e) => {
                    e.preventDefault();
                    const zoomFactor = e.deltaY < 0 ? 1.15 : 0.85;
                    this.zoom = Math.max(0.3, Math.min(3.0, this.zoom * zoomFactor));
                });
            }

            inspectNode(node) {
                const hint = document.getElementById(`inspector-hint-${this.incId}`);
                const content = document.getElementById(`inspector-content-${this.incId}`);
                if (hint) hint.style.display = 'none';
                if (!content) return;

                const color = this.getNodeColor(node.type);
                content.style.display = 'block';
                content.innerHTML = `
                    <div class="inspector-card" style="border-left: 3px solid ${color};">
                        <div style="font-size: 0.7rem; color: #94a3b8; text-transform: uppercase;">Selected Graph Node</div>
                        <div style="font-weight: 800; color: #fff; font-size: 1rem; margin-top: 2px;">${node.label}</div>
                        <div style="font-size: 0.75rem; color: ${color}; font-weight: 700; margin-top: 3px;">${node.role}</div>
                    </div>

                    <div class="inspector-card">
                        <div style="color: #94a3b8; font-size: 0.7rem;">Criticality Assessment</div>
                        <div style="font-weight: 700; color: #fff; margin-top: 2px;">${node.criticality}</div>
                        <div style="font-size: 0.75rem; color: #cbd5e1; margin-top: 4px; line-height: 1.4;">
                            ${node.type === 'adversary' ? 'Originating external threat actor attacking through WAN interface.' :
                              node.type === 'host' ? 'Directly breached DMZ asset executing attacker commands.' :
                              node.type === 'user' ? 'Compromised credentials leveraged for privilege escalation.' :
                              node.type === 'c2' ? 'External C2 beacon/exfiltration receiver server.' :
                              node.type === 'dc' ? 'Critical tier-0 Active Directory / Database vault target in 2-hop radius.' :
                              'Neighboring host on same L2 broadcast domain vulnerable to lateral sweep.'}
                        </div>
                    </div>

                    <div class="inspector-card">
                        <div style="color: #94a3b8; font-size: 0.7rem;">Parent Incident Context</div>
                        <div style="font-weight: 700; color: #38bdf8;">Incident #${this.data.incident_id} (Campaign Risk: <span style="color: #ef4444;">${this.data.risk_score} / 100</span>)</div>
                        <div style="font-size: 0.75rem; color: #94a3b8; margin-top: 3px;">
                            ${node.type === 'adversary' ? 'Threat Ingress Vector &bull; Initial Exploit' :
                              node.type === 'host' ? 'Weaponized DMZ Server &bull; Lateral Pivot' :
                              node.type === 'user' ? 'Compromised Identity &bull; Credential Theft' :
                              node.type === 'dc' ? 'Crown Jewel Blast Target &bull; Active Directory' :
                              node.type === 'c2' ? 'Exfiltration Sink &bull; C2 Beaconing' : 'Subnet L2 Neighbor'}
                        </div>
                    </div>

                    <div class="inspector-card">
                        <div style="color: #94a3b8; font-size: 0.7rem;">Actionable Playbook Step</div>
                        <div style="font-size: 0.75rem; color: #38bdf8; font-weight: 600; margin-top: 3px;">
                            ${node.type === 'adversary' ? 'Null-route IP on perimeter FortiGate WAN policy.' :
                              node.type === 'host' ? 'Isolate switch port / move to quarantine VLAN.' :
                              node.type === 'user' ? 'Revoke Kerberos TGT & force AD password reset.' :
                              node.type === 'dc' ? 'Apply emergency ZeroLogon hardening patch & monitor Kerberos logs.' :
                              'Block egress beaconing to IP.'}
                        </div>
                    </div>
                `;
            }

            getNodeColor(type) {
                switch(type) {
                    case 'adversary': return '#ef4444';
                    case 'host': return '#06b6d4';
                    case 'user': return '#f59e0b';
                    case 'c2': return '#a855f7';
                    case 'dc': return '#f43f5e';
                    case 'peer': return '#64748b';
                    default: return '#94a3b8';
                }
            }

            startSimulation() {
                const step = (now) => {
                    const dt = (now - this.lastFrameTime) / 1000.0;
                    this.lastFrameTime = now;

                    if (this.isPlaying) {
                        const nextT = this.tNow + (dt * this.playSpeed);
                        if (nextT >= this.maxTime) {
                            this.setTime(this.maxTime);
                            this.togglePlay();
                        } else {
                            this.setTime(nextT);
                        }
                    }

                    if (this.isPhysicsRunning) {
                        this.updatePhysics();
                    }

                    // Advance marching-ants dash offset & particles
                    this.dashOffset = (this.dashOffset + 0.5) % 16;
                    this.particles.forEach(p => {
                        p.progress = (p.progress + p.speed) % 1.0;
                    });

                    this.render();
                    requestAnimationFrame(step);
                };
                requestAnimationFrame(step);
            }

            updatePhysics() {
                const kRepel = 18000;
                const kSpring = 0.08;
                const restLength = 135;

                // 1. Repulsion between all node pairs
                for (let i = 0; i < this.nodes.length; i++) {
                    for (let j = i + 1; j < this.nodes.length; j++) {
                        const n1 = this.nodes[i];
                        const n2 = this.nodes[j];
                        const dx = n2.x - n1.x;
                        const dy = n2.y - n1.y;
                        const dist = Math.hypot(dx, dy) || 1;
                        
                        const force = Math.min(kRepel / (dist * dist), 18);
                        const fx = (dx / dist) * force;
                        const fy = (dy / dist) * force;

                        if (n1 !== this.draggedNode) { n1.vx -= fx; n1.vy -= fy; }
                        if (n2 !== this.draggedNode) { n2.vx += fx; n2.vy += fy; }
                    }
                }

                // 2. Spring forces along edges
                this.edges.forEach(e => {
                    const n1 = e.source;
                    const n2 = e.target;
                    const dx = n2.x - n1.x;
                    const dy = n2.y - n1.y;
                    const dist = Math.hypot(dx, dy) || 1;
                    const force = (dist - restLength) * kSpring;
                    const fx = (dx / dist) * force;
                    const fy = (dy / dist) * force;

                    if (n1 !== this.draggedNode) { n1.vx += fx; n1.vy += fy; }
                    if (n2 !== this.draggedNode) { n2.vx -= fx; n2.vy += fy; }
                });

                // 3. Center gravity towards (0, 0) and viewport clamping
                const halfW = (this.canvas.width / (2 * (this.zoom || 1))) - 45;
                const halfH = (this.canvas.height / (2 * (this.zoom || 1))) - 40;

                this.nodes.forEach(n => {
                    if (n !== this.draggedNode) {
                        n.vx -= n.x * 0.04;
                        n.vy -= n.y * 0.04;
                        n.vx *= 0.65;
                        n.vy *= 0.65;
                        n.x += n.vx;
                        n.y += n.vy;

                        // Viewport bounds clamping - nodes NEVER fly off canvas!
                        n.x = Math.max(-halfW, Math.min(halfW, n.x));
                        n.y = Math.max(-halfH, Math.min(halfH, n.y));
                    }
                });
            }

            render() {
                const ctx = this.ctx;
                const w = this.canvas.width;
                const h = this.canvas.height;

                ctx.save();
                ctx.clearRect(0, 0, w, h);

                // Neo4j Bloom style background grid dots
                ctx.fillStyle = '#1e293b';
                const gridSize = Math.max(16, 32 * this.zoom);
                const offX = ((this.panX % gridSize) + gridSize) % gridSize;
                const offY = ((this.panY % gridSize) + gridSize) % gridSize;
                for (let x = offX; x < w; x += gridSize) {
                    for (let y = offY; y < h; y += gridSize) {
                        ctx.fillRect(x, y, 1.4, 1.4);
                    }
                }

                ctx.translate(this.panX, this.panY);
                ctx.scale(this.zoom, this.zoom);

                // Draw Edges
                this.edges.forEach((e, eIdx) => {
                    const n1 = e.source;
                    const n2 = e.target;
                    const s1 = this.getNodeState(n1);
                    const s2 = this.getNodeState(n2);
                    const isEdgeProjected = (s2 === 'PROJECTED');

                    const dx = n2.x - n1.x;
                    const dy = n2.y - n1.y;
                    const dist = Math.hypot(dx, dy) || 1;
                    const ux = dx / dist;
                    const uy = dy / dist;

                    const startX = n1.x + ux * n1.radius;
                    const startY = n1.y + uy * n1.radius;
                    const endX = n2.x - ux * (n2.radius + 6);
                    const endY = n2.y - uy * (n2.radius + 6);

                    ctx.beginPath();
                    ctx.moveTo(startX, startY);
                    ctx.lineTo(endX, endY);

                    if (isEdgeProjected) {
                        ctx.strokeStyle = '#38bdf8';
                        ctx.lineWidth = 1.6;
                        ctx.lineDashOffset = -this.dashOffset;
                        ctx.setLineDash([6, 6]);
                    } else {
                        ctx.strokeStyle = (s2 === 'ACTIVE') ? '#f59e0b' : '#38bdf8';
                        ctx.lineWidth = 2.2;
                        ctx.setLineDash([]);
                    }
                    ctx.stroke();
                    ctx.setLineDash([]);
                    ctx.lineDashOffset = 0;

                    // Traveling active particles
                    if (s1 === 'ACTIVE' || s2 === 'ACTIVE') {
                        const p = this.particles.find(part => part.edgeIndex === eIdx);
                        if (p) {
                            const px = startX + (endX - startX) * p.progress;
                            const py = startY + (endY - startY) * p.progress;
                            ctx.beginPath();
                            ctx.arc(px, py, 3.5, 0, Math.PI * 2);
                            ctx.fillStyle = '#ffffff';
                            ctx.shadowColor = '#f59e0b';
                            ctx.shadowBlur = 8;
                            ctx.fill();
                            ctx.shadowBlur = 0;
                        }
                    }

                    // Arrowhead
                    const angle = Math.atan2(dy, dx);
                    ctx.beginPath();
                    ctx.moveTo(endX, endY);
                    ctx.lineTo(
                        endX - 8 * Math.cos(angle - Math.PI / 6),
                        endY - 8 * Math.sin(angle - Math.PI / 6)
                    );
                    ctx.lineTo(
                        endX - 8 * Math.cos(angle + Math.PI / 6),
                        endY - 8 * Math.sin(angle + Math.PI / 6)
                    );
                    ctx.closePath();
                    ctx.fillStyle = isEdgeProjected ? '#38bdf8' : '#f59e0b';
                    ctx.fill();

                    // Neo4j Relationship Pill Badge
                    const mx = (startX + endX) / 2;
                    const my = (startY + endY) / 2;
                    ctx.font = 'bold 8px monospace';
                    const text = isEdgeProjected ? `${e.rel} (P=${Math.round(n2.projectedProb * 100)}%)` : (e.rel || e.tech_id);
                    const textW = ctx.measureText(text).width;

                    ctx.fillStyle = '#080d16';
                    ctx.fillRect(mx - textW / 2 - 4, my - 6, textW + 8, 12);
                    ctx.strokeStyle = isEdgeProjected ? '#38bdf8' : '#334155';
                    ctx.lineWidth = 0.8;
                    ctx.strokeRect(mx - textW / 2 - 4, my - 6, textW + 8, 12);

                    ctx.fillStyle = isEdgeProjected ? '#7dd3fc' : '#cbd5e1';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillText(text, mx, my);
                });

                // Draw Nodes
                this.nodes.forEach(n => {
                    const state = this.getNodeState(n);
                    const baseColor = this.getNodeColor(n.type);
                    const isSelected = n === this.selectedNode;
                    const isHovered = n === this.hoveredNode;

                    if (state === 'PROJECTED') {
                        ctx.beginPath();
                        ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);
                        ctx.fillStyle = 'rgba(15, 23, 42, 0.4)';
                        ctx.fill();
                        ctx.strokeStyle = '#38bdf8';
                        ctx.lineWidth = 2.0;
                        ctx.setLineDash([4, 4]);
                        ctx.stroke();
                        ctx.setLineDash([]);

                        ctx.fillStyle = '#38bdf8';
                        ctx.font = 'bold 8px monospace';
                        ctx.textAlign = 'center';
                        ctx.fillText(`P=${Math.round(n.projectedProb * 100)}% ETA +${n.etaMinutes}m`, n.x, n.y - n.radius - 8);

                    } else if (state === 'ACTIVE') {
                        const pulse = (Date.now() % 1200) / 1200.0;
                        const rippleRadius = n.radius + (pulse * 24);
                        const rippleAlpha = Math.exp(-pulse * 2.2);

                        ctx.save();
                        ctx.globalCompositeOperation = 'lighter';
                        ctx.beginPath();
                        ctx.arc(n.x, n.y, rippleRadius, 0, Math.PI * 2);
                        ctx.strokeStyle = `rgba(245, 158, 11, ${rippleAlpha})`;
                        ctx.lineWidth = 2.0;
                        ctx.stroke();
                        ctx.restore();

                        ctx.beginPath();
                        ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);
                        ctx.fillStyle = '#0f172a';
                        ctx.strokeStyle = '#f59e0b';
                        ctx.lineWidth = 3.2;
                        ctx.fill();
                        ctx.stroke();

                        ctx.beginPath();
                        ctx.arc(n.x, n.y, 8, 0, Math.PI * 2);
                        ctx.fillStyle = '#ffffff';
                        ctx.shadowColor = '#f59e0b';
                        ctx.shadowBlur = 12;
                        ctx.fill();
                        ctx.shadowBlur = 0;

                        ctx.fillStyle = '#f59e0b';
                        ctx.font = 'bold 8.5px sans-serif';
                        ctx.textAlign = 'center';
                        ctx.fillText('ACTIVE', n.x, n.y - n.radius - 8);

                    } else {
                        ctx.beginPath();
                        ctx.arc(n.x, n.y, n.radius + (isSelected ? 7 : 4), 0, Math.PI * 2);
                        ctx.fillStyle = baseColor + '33';
                        ctx.fill();

                        ctx.beginPath();
                        ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);
                        ctx.fillStyle = '#0b1120';
                        ctx.strokeStyle = baseColor;
                        ctx.lineWidth = isSelected ? 3.5 : 2.2;
                        ctx.fill();
                        ctx.stroke();
                    }

                    ctx.fillStyle = (state === 'ACTIVE') ? '#ffffff' : (state === 'PROJECTED') ? '#38bdf8' : baseColor;
                    ctx.font = 'bold 8.5px sans-serif';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    const iconText = n.type === 'adversary' ? 'WAN' :
                                     n.type === 'host' ? 'HOST' :
                                     n.type === 'user' ? 'USER' :
                                     n.type === 'dc' ? 'DC' :
                                     n.type === 'c2' ? 'C2' : 'PEER';
                    ctx.fillText(iconText, n.x, n.y);

                    ctx.fillStyle = '#f8fafc';
                    ctx.font = '9.5px monospace';
                    ctx.fillText(n.label, n.x, n.y + n.radius + 11);
                });

                ctx.restore();
            }

            resetView() {
                this.panX = this.cssWidth / 2;
                this.panY = this.cssHeight / 2;
                this.zoom = 1.0;
                this.alpha = 0.8;
            }

            zoom(factor) {
                this.zoom = Math.max(0.3, Math.min(3.0, this.zoom * factor));
            }

            togglePhysics() {
                this.isPhysicsRunning = !this.isPhysicsRunning;
                if (this.isPhysicsRunning) {
                    this.alpha = 0.5;
                }
            }
        }

        // Initialize all incident graphs
        function initAllGraphs() {
            if (!INCIDENTS_DATA || typeof InteractiveForceGraph === 'undefined') return;
            INCIDENTS_DATA.forEach(inc => {
                const canvasId = `graph-canvas-${inc.incident_id}`;
                const el = document.getElementById(canvasId);
                if (el && !GRAPH_INSTANCES[inc.incident_id]) {
                    GRAPH_INSTANCES[inc.incident_id] = new InteractiveForceGraph(canvasId, inc);
                }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initAllGraphs);
        } else {
            initAllGraphs();
        }
        window.addEventListener('load', initAllGraphs);
        setTimeout(initAllGraphs, 150);
        setTimeout(initAllGraphs, 600);

        function resetGraphView(incId) {
            if (GRAPH_INSTANCES[incId]) GRAPH_INSTANCES[incId].resetView();
        }

        function zoomGraph(incId, factor) {
            if (GRAPH_INSTANCES[incId]) GRAPH_INSTANCES[incId].zoom(factor);
        }

        function togglePhysics(incId) {
            if (GRAPH_INSTANCES[incId]) GRAPH_INSTANCES[incId].togglePhysics();
        }

        function togglePlay(incId) {
            if (GRAPH_INSTANCES[incId]) GRAPH_INSTANCES[incId].togglePlay();
        }

        function resetScrubber(incId) {
            if (GRAPH_INSTANCES[incId]) {
                GRAPH_INSTANCES[incId].isPlaying = false;
                const btn = document.getElementById(`btn-play-${incId}`);
                if (btn) { btn.innerHTML = '▶ Play Campaign'; btn.style.background = '#1e293b'; }
                GRAPH_INSTANCES[incId].setTime(0);
            }
        }

        function stepScrubber(incId, delta) {
            if (GRAPH_INSTANCES[incId]) {
                GRAPH_INSTANCES[incId].setTime(GRAPH_INSTANCES[incId].tNow + delta);
            }
        }

        function onScrubInput(incId, val) {
            if (GRAPH_INSTANCES[incId]) {
                GRAPH_INSTANCES[incId].setTime(val);
            }
        }
    </script>
</body>
</html>
